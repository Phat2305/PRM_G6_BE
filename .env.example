# =====================================================================
# CẤU HÌNH MÔI TRƯỜNG DỰ ÁN ART_COURSE (SPRING BOOT & POSTGRESQL)
# =====================================================================
# Sao chép file này thành .env trên máy của bạn và điều chỉnh cấu hình tương ứng:
# cp .env.example .env

# 1. Cơ sở dữ liệu PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/art_course
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=12345

# 2. Cổng chạy ứng dụng Backend
PORT=8080

# 3. Khóa bí mật JWT (tối thiểu 32 ký tự / 256 bits)
JWT_SECRET=FALL2026_ART_COURSE_PRM391_GROUP_6

# 4. Cổng thanh toán VNPay Sandbox (Tùy chọn khi test thanh toán thật)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# 5. Cổng thanh toán MoMo Sandbox (Tùy chọn)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
